# ── Groq API (NLP for voice transcript parsing) ──────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ── Firebase (Firestore + Cloud Messaging) ────────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=
# Firebase Cloud Messaging server key (for push notifications)
FCM_SERVER_KEY=

# ── Google Cloud Speech-to-Text (optional — browser Web Speech API is used by default) ──
GOOGLE_APPLICATION_CREDENTIALS=

# ── App Config ────────────────────────────────────────────────────────────────
# API base URL (leave empty to use Vite proxy in development)
VITE_API_URL=
